APP_PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=bandung_coffeeshop
DB_SSLMODE=disable
# Public image host used to render R2 keys (e.g. ig/<location>/<shortcode>/0.jpg)
IMAGE_BASE_URL=https://image.bdgcafe.com
# Timezone used to display and enter times (DB timestamps are UTC)
DISPLAY_TZ=Asia/Jakarta
# Cloudflare R2 (secret) for image uploads from the cafe / location forms, stored at
# cafe/<slug>/<file> and location/<slug>/<file>. Leave blank to disable uploads (URLs can still be typed).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
