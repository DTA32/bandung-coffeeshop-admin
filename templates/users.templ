package templates

import (
	"net/url"

	"github.com/dta32/bandung-coffeeshop-admin/models"
)

// UserListID is the id of the list container; the typeahead and the status
// tabs target it (utils.ParseListParams recognises the HX-Target).
const UserListID = "user-list"

// UserFilter is the active /users search text and status tab.
type UserFilter struct {
	Q      string
	Status string // all | active | deleted
}

// UsersPage lists public-site users with server-side search (name / email),
// a status tab filter and infinite scroll. Delete / revive only flip
// users.status: the BE logs a deleted user out on their next request and hides
// their reviews until they are revived.
templ UsersPage(items []models.User, f UserFilter, next string) {
	@Layout("Users", NavUsers) {
		@Page(pageCls) {
			@BackLink("/", "Admin home")
			<h1 class={ h1Cls }>Users</h1>
			<p class={ introCls }>
				Accounts that signed in on the public site. Deleting a user logs them out
				immediately and hides their reviews; reviving restores both.
			</p>
			<form id="user-filters" method="get" action="/users" role="search">
				<input
					id="user-search"
					class={ searchCls, "w-full" }
					type="search"
					name="q"
					value={ f.Q }
					placeholder="Search name or email..."
					aria-label="Search users"
					autocomplete="off"
					hx-get="/users"
					hx-trigger="input changed delay:300ms, search"
					hx-include="#user-status"
					hx-target={ "#" + UserListID }
					hx-swap="innerHTML"
					hx-push-url="true"
					hx-sync="this:replace"
				/>
			</form>
			<div id={ UserListID } class="flex flex-col gap-4">
				@UserResults(items, f, next)
			</div>
		}
	}
}

// UserResults is the typeahead / tab fragment: status tabs and the table with
// its first page. The hidden status input belongs to the search form so a
// search keeps the selected tab.
templ UserResults(items []models.User, f UserFilter, next string) {
	<input type="hidden" id="user-status" name="status" value={ f.Status } form="user-filters"/>
	<nav class="flex flex-wrap gap-2" aria-label="Filter by status">
		for _, t := range userTabs {
			<a
				href={ templ.URL(usersURL(f.Q, t.status)) }
				class={ tabCls, templ.KV(tabActiveCls, t.status == f.Status), templ.KV(tabIdleCls, t.status != f.Status) }
				if t.status == f.Status {
					aria-current="page"
				}
				hx-get={ usersURL(f.Q, t.status) }
				hx-target={ "#" + UserListID }
				hx-swap="innerHTML"
				hx-push-url="true"
			>{ t.label }</a>
		}
	</nav>
	<section class={ cardCls }>
		if len(items) == 0 {
			<p class="m-0 text-sm text-bark">{ usersEmpty(f) }</p>
		} else {
			<div class="overflow-x-auto">
				<table class="w-full text-left text-sm text-forest">
					<thead>
						<tr class="border-b border-grove-light text-xs font-semibold text-bark">
							<th class="py-2 pr-3">Name</th>
							<th class="py-2 pr-3">Email</th>
							<th class="py-2 pr-3">Status</th>
							<th class="py-2 pr-3">Joined</th>
							<th class="py-2"><span class="sr-only">Actions</span></th>
						</tr>
					</thead>
					<tbody>
						@UserRows(items, next)
					</tbody>
				</table>
			</div>
		}
	</section>
}

// UserRows renders user rows and the next-page sentinel; used by the full page,
// the results fragment and the infinite-scroll fragment.
templ UserRows(items []models.User, next string) {
	for _, u := range items {
		@UserRow(u)
	}
	@LoadMoreRow(next, 5)
}

// UserRow is one user; delete / revive swap it in place (outerHTML).
templ UserRow(u models.User) {
	<tr id={ "user-" + itoa(u.ID) } class="border-b border-grove-light/60 align-middle last:border-0">
		<td class="py-2 pr-3 font-semibold">{ u.Name }</td>
		<td class="py-2 pr-3 break-all">{ u.Email }</td>
		<td class="py-2 pr-3">
			@StatusBadge(u.Status)
		</td>
		<td class="py-2 pr-3 whitespace-nowrap">{ fmtTime(u.CreatedAt) }</td>
		<td class="py-2 text-right">
			if u.Status == models.UserStatusDeleted {
				<button
					type="button"
					class={ btnOutlineSmCls, "ml-auto" }
					hx-post={ "/users/" + itoa(u.ID) + "/revive" }
					hx-target="closest tr"
					hx-swap="outerHTML"
					hx-disabled-elt="this"
				>Revive</button>
			} else {
				<button
					type="button"
					class={ btnDeleteSmCls, "ml-auto" }
					hx-post={ "/users/" + itoa(u.ID) + "/delete" }
					hx-confirm="Delete this user? They'll be logged out and their reviews hidden until revived."
					hx-target="closest tr"
					hx-swap="outerHTML"
					hx-disabled-elt="this"
				>
					@Icon("trash-2", 14)
					Delete
				</button>
			}
		</td>
	</tr>
}

const (
	tabCls       = "rounded-lg px-3 py-1.5 text-sm font-semibold no-underline"
	tabActiveCls = "bg-forest text-cream"
	tabIdleCls   = "border border-grove-light text-forest hover:bg-forest-lighter"
)

var userTabs = []struct{ status, label string }{
	{models.UserFilterAll, "All"},
	{models.UserStatusActive, "Active"},
	{models.UserStatusDeleted, "Deleted"},
}

// usersURL builds /users?q=&status=, leaving out the defaults.
func usersURL(q, status string) string {
	v := url.Values{}
	if q != "" {
		v.Set("q", q)
	}
	if status != "" && status != models.UserFilterAll {
		v.Set("status", status)
	}
	if len(v) == 0 {
		return "/users"
	}
	return "/users?" + v.Encode()
}

func usersEmpty(f UserFilter) string {
	if f.Q == "" && f.Status == models.UserFilterAll {
		return "No users yet."
	}
	return emptyListText("users", f.Q)
}
