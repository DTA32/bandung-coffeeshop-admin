package templates

// Icon renders a lucide icon (https://lucide.dev, ISC) inline, matching the
// console's lucide-react icons.
templ Icon(name string, size int) {
	<svg
		xmlns="http://www.w3.org/2000/svg"
		width={ itoa(size) }
		height={ itoa(size) }
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
		class="shrink-0"
	>
		switch name {
			case "arrow-left":
				<path d="m12 19-7-7 7-7"></path>
				<path d="M19 12H5"></path>
			case "users":
				<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
				<circle cx="9" cy="7" r="4"></circle>
				<path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
				<path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
			case "plus":
				<path d="M5 12h14"></path>
				<path d="M12 5v14"></path>
			case "trash-2":
				<path d="M3 6h18"></path>
				<path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
				<path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path>
				<line x1="10" x2="10" y1="11" y2="17"></line>
				<line x1="14" x2="14" y1="11" y2="17"></line>
			case "arrow-up":
				<path d="m5 12 7-7 7 7"></path>
				<path d="M12 19V5"></path>
			case "arrow-down":
				<path d="M12 5v14"></path>
				<path d="m19 12-7 7-7-7"></path>
			case "coffee":
				<path d="M10 2v2"></path>
				<path d="M14 2v2"></path>
				<path d="M16 8a1 1 0 0 1 1 1v8a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V9a1 1 0 0 1 1-1h14a4 4 0 1 1 0 8h-1"></path>
				<path d="M6 2v2"></path>
			case "map-pin":
				<path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path>
				<circle cx="12" cy="10" r="3"></circle>
			case "tag":
				<path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"></path>
				<circle cx="7.5" cy="7.5" r=".5" fill="currentColor"></circle>
			case "layers":
				<path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"></path>
				<path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"></path>
				<path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"></path>
			case "star":
				<path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"></path>
			case "list-checks":
				<path d="m3 17 2 2 4-4"></path>
				<path d="m3 7 2 2 4-4"></path>
				<path d="M13 6h8"></path>
				<path d="M13 12h8"></path>
				<path d="M13 18h8"></path>
			case "image":
				<rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
				<circle cx="9" cy="9" r="2"></circle>
				<path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path>
			case "activity":
				<path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"></path>
			case "external-link":
				<path d="M15 3h6v6"></path>
				<path d="M10 14 21 3"></path>
				<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h3"></path>
			case "check":
				<path d="M20 6 9 17l-5-5"></path>
			case "x":
				<path d="M18 6 6 18"></path>
				<path d="m6 6 12 12"></path>
			case "pencil":
				<path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"></path>
				<path d="m15 5 4 4"></path>
			case "eye":
				<path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path>
				<circle cx="12" cy="12" r="3"></circle>
			case "eye-off":
				<path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"></path>
				<path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"></path>
				<path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"></path>
				<path d="m2 2 20 20"></path>
			case "rotate-ccw":
				<path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
				<path d="M3 3v5h5"></path>
			case "newspaper":
				<path d="M15 18h-5"></path>
				<path d="M18 14h-8"></path>
				<path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-4 0v-9a2 2 0 0 1 2-2h2"></path>
				<rect width="8" height="4" x="10" y="6" rx="1"></rect>
		}
	</svg>
}
