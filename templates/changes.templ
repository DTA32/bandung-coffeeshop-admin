package templates

import "github.com/dta32/bandung-coffeeshop-admin/models"

templ ChangesPage(groups []models.CafeProposals, cafeFilter int, next, ok, errMsg string) {
	@Layout("Changes", NavChanges) {
		@Page(pageCls) {
			@BackLink("/", "Admin home")
			<div class="flex items-center justify-between">
				<h1 class={ h1Cls }>Changes</h1>
				if cafeFilter != 0 {
					<a href="/changes" class={ btnCancelCls }>Show all cafes</a>
				}
			</div>
			<p class={ introCls }>
				Field changes the scraper detected, grouped by cafe. Approving writes the live
				value and bumps the cafe's last-updated date. Informational rows only need a look.
			</p>
			@Notice(ok, errMsg)
			<div id="batch-flash" role="status"></div>
			if len(groups) == 0 {
				<p class="m-0 text-sm text-bark">Nothing to review.</p>
			} else {
				<label class={ checkRowCls, "text-sm text-bark" }>
					<input type="checkbox" id="batch-all" aria-label="Select all loaded changes"/>
					Select all loaded
				</label>
			}
			<form id="batch-form" method="post" action="/changes/batch" hx-post="/changes/batch" hx-swap="none" hx-disabled-elt="#batch-bar button"></form>
			@ChangeGroups(groups, next)
			@batchBar()
		}
	}
}

// ChangeGroups renders cafe groups of proposals plus the next-page sentinel
// (full page and fragment responses).
templ ChangeGroups(groups []models.CafeProposals, next string) {
	for _, g := range groups {
		<section class={ cardCls } id={ "cafe-" + itoa(g.CafeID) } data-change-group>
			<div class="flex flex-wrap items-center justify-between gap-2">
				<div class="flex items-baseline gap-2">
					<a class="text-base font-bold text-forest hover:underline" href={ templ.URL("/cafes/" + g.LocationID) }>{ g.CafeName }</a>
					<span class="text-xs text-bark">{ g.LocationID }</span>
				</div>
				if hasApplicable(g.Items) {
					<form
						method="post"
						action={ templ.URL("/changes/cafe/" + itoa(g.CafeID) + "/approve-all") }
					>
						<button class={ btnOutlineSmCls } type="submit" data-confirm="Approve every proposed value for this cafe as-is?">
							@Icon("check", 14)
							Approve all
						</button>
					</form>
				}
			</div>
			<div class="flex flex-col">
				for _, p := range g.Items {
					@ProposalRow(p, "")
				}
			</div>
		</section>
	}
	@LoadMore(next)
}

func hasApplicable(items []models.Proposal) bool {
	for _, p := range items {
		if !models.IsInformational(p.Field) {
			return true
		}
	}
	return false
}

templ ProposalRow(p models.Proposal, errMsg string) {
	<div id={ "proposal-" + i64(p.ID) } class="grid grid-cols-1 gap-3 border-t border-grove-light py-3 md:grid-cols-[10rem_1fr_9.5rem]">
		<div class="flex flex-col gap-1">
			<label class="flex items-center gap-2">
				<input type="checkbox" name="id" value={ i64(p.ID) } form="batch-form" data-batch-row aria-label={ "Select " + fieldLabel(p.Field) }/>
				<span class="text-sm font-semibold text-forest">{ fieldLabel(p.Field) }</span>
			</label>
			@SourceBadge(p.Source)
			<span class="text-xs text-bark" title={ fmtTime(p.CreatedAt) }>detected { ago(p.CreatedAt) }</span>
		</div>
		<div class="flex min-w-0 flex-col gap-2 text-sm text-forest">
			if models.IsInformational(p.Field) {
				<div class="whitespace-pre-wrap break-words rounded-xl bg-forest-lighter p-3">{ displayValue(p.Field, p.NewValue) }</div>
				if p.Field == "ig_bio" && len(p.OldValue) > 0 {
					<details class="text-xs text-bark">
						<summary class="cursor-pointer">Previous bio</summary>
						<div class="mt-1 whitespace-pre-wrap">{ displayValue(p.Field, p.OldValue) }</div>
					</details>
				}
			} else if p.Field == "hours" {
				if rows, ok := hoursComparison(p); ok {
					@hoursCompareTable(rows)
				} else {
					<p class="m-0 text-xs text-red-600">This hours proposal is in an old format and cannot be approved; reject it.</p>
					<pre class="m-0 overflow-x-auto whitespace-pre-wrap break-words rounded-xl bg-forest-lighter p-3 text-xs">{ prettyJSON(p.NewValue) }</pre>
				}
			} else {
				<div class="grid grid-cols-[4.5rem_1fr] gap-x-2 gap-y-1">
					<span class={ labelCls }>Now</span>
					<span class="break-words">{ displayValue(p.Field, p.Current) }</span>
					<span class={ labelCls }>Proposed</span>
					<span class="break-words font-semibold text-moss">{ displayValue(p.Field, p.NewValue) }</span>
				</div>
			}
			<div class="flex flex-wrap gap-3 text-xs">
				if p.EvidenceURL != nil {
					<a class={ "flex items-center gap-1", inlineLinkCls } href={ templ.URL(*p.EvidenceURL) } target="_blank" rel="noopener noreferrer">
						Source
						@Icon("external-link", 12)
					</a>
				}
				if p.SnapshotID != nil {
					<a class={ inlineLinkCls } href={ templ.URL("/snapshots/" + i64p(p.SnapshotID)) } target="_blank">Raw snapshot</a>
				}
			</div>
			if days := hoursDays(p.NewValue); len(days) > 0 {
				<details class="text-xs text-bark">
					<summary class="cursor-pointer">Raw hours from Google</summary>
					<ul class="mt-1 pl-4">
						for _, d := range days {
							<li>{ d }</li>
						}
					</ul>
				</details>
			}
			<p id={ "proposal-err-" + i64(p.ID) } class={ rowErrorCls } role="alert" hidden?={ errMsg == "" }>{ errMsg }</p>
		</div>
		<div class="flex flex-col items-stretch gap-1">
			if models.IsInformational(p.Field) {
				<a class={ btnOutlineSmCls } href={ templ.URL("/cafes/" + p.LocationID) }>Open cafe</a>
				<button
					class={ btnOutlineSmCls }
					hx-post={ "/changes/" + i64(p.ID) + "/reject" }
					hx-target={ "#proposal-" + i64(p.ID) }
					hx-swap="outerHTML"
					hx-disabled-elt="this"
				>Dismiss</button>
			} else {
				if approvable(p) {
					<button
						class={ btnPrimarySmCls }
						hx-post={ "/changes/" + i64(p.ID) + "/approve" }
						hx-target={ "#proposal-" + i64(p.ID) }
						hx-swap="outerHTML"
						hx-disabled-elt="this"
					>
						@Icon("check", 14)
						Approve
					</button>
				}
				if p.Field != "hours" {
					<details>
						<summary class={ "list-none cursor-pointer", btnOutlineSmCls }>
							@Icon("pencil", 14)
							Edit & approve
						</summary>
						<form
							class="mt-2 flex flex-col gap-1"
							hx-post={ "/changes/" + i64(p.ID) + "/approve" }
							hx-target={ "#proposal-" + i64(p.ID) }
							hx-swap="outerHTML"
						>
							<input type="hidden" name="edit" value="1"/>
							@proposalEditInputs(p)
							<button class={ btnPrimarySmCls } type="submit">Save & approve</button>
						</form>
					</details>
				}
				<button
					class={ "justify-center", btnDeleteSmCls }
					hx-post={ "/changes/" + i64(p.ID) + "/reject" }
					hx-target={ "#proposal-" + i64(p.ID) }
					hx-swap="outerHTML"
					hx-disabled-elt="this"
				>
					@Icon("x", 14)
					Reject
				</button>
			}
		</div>
		if p.Field == "hours" && approvable(p) {
			@hoursEditApprove(p)
		}
	</div>
}

// hoursEditApprove is "Edit & approve" for an hours proposal: the per-day
// editor prefilled with the proposed rows, full width under the row. The
// window is not editable; it comes from the proposal.
templ hoursEditApprove(p models.Proposal) {
	{{ from, until := hoursWindow(p.NewValue) }}
	<details class="md:col-span-3">
		<summary class={ "w-fit list-none cursor-pointer", btnOutlineSmCls }>
			@Icon("pencil", 14)
			Edit & approve
		</summary>
		<form
			class="mt-3 flex flex-col gap-3 rounded-xl border border-grove-light p-4"
			hx-post={ "/changes/" + i64(p.ID) + "/approve" }
			hx-target={ "#proposal-" + i64(p.ID) }
			hx-swap="outerHTML"
		>
			<input type="hidden" name="edit" value="1"/>
			<p class="m-0 text-xs text-bark">
				Approving replaces the regular hours and the special dates between { from } and { until }.
				Special dates outside those days are kept.
			</p>
			@HoursEditor(hoursProposalRows(p.NewValue))
			<button class={ "w-fit", btnPrimarySmCls } type="submit">Save & approve</button>
		</form>
	</details>
}

templ proposalEditInputs(p models.Proposal) {
	switch p.Field {
		case "status":
			<select class={ inputCls } name="value" aria-label="Status">
				<option value="closed" selected?={ jsonString(p.NewValue) == "closed" }>closed</option>
				<option value="active" selected?={ jsonString(p.NewValue) == "active" }>active</option>
			</select>
		case "address":
			<textarea class={ inputCls } name="value" rows="3" aria-label="Address">{ jsonString(p.NewValue) }</textarea>
		default:
			<input class={ inputCls } name="value" value={ jsonString(p.NewValue) } aria-label={ fieldLabel(p.Field) }/>
	}
}

templ ProposalResolved(p models.Proposal, status, detail string) {
	<div id={ "proposal-" + i64(p.ID) } class="flex flex-wrap items-center gap-2 border-t border-grove-light py-3 text-sm text-forest">
		<span class="font-semibold">{ fieldLabel(p.Field) }</span>
		@StatusBadge(status)
		if detail != "" {
			<span class="text-bark">{ detail }</span>
		}
	</div>
}

// batchBar is the sticky action bar shown while 1+ rows are selected
// (static/js/forms.js toggles it and fills the count / confirm texts). Its
// buttons submit the empty #batch-form via the form attribute.
templ batchBar() {
	<div id="batch-bar" class="sticky bottom-4 z-10 flex flex-wrap items-center gap-3 rounded-2xl border border-grove-light bg-white p-3 shadow-md" hidden>
		<span class="text-sm font-semibold text-forest" data-batch-count>0 selected</span>
		<div class="ml-auto flex flex-wrap gap-2">
			<button type="submit" form="batch-form" name="action" value="approve" class={ btnPrimarySmCls } data-confirm="Approve selected changes?" data-batch-approve>
				@Icon("check", 14)
				Approve selected
			</button>
			<button type="submit" form="batch-form" name="action" value="reject" class={ btnDeleteSmCls } data-confirm="Reject selected changes?" data-batch-reject>
				@Icon("x", 14)
				Reject selected
			</button>
			<button type="button" class={ btnOutlineSmCls } data-batch-clear>Clear</button>
		</div>
	</div>
}

// BatchResult is the HTMX response of POST /changes/batch, all out-of-band:
// the summary flash, deletion of processed rows and the reason under each
// failed row (which stays in the list, still selected).
templ BatchResult(res models.BatchResult, msg string, isErr bool) {
	<div id="batch-flash" role="status" hx-swap-oob="true">
		if isErr {
			<div class={ errorBoxCls }>{ msg }</div>
		} else {
			<div class={ okBoxCls }>{ msg }</div>
		}
	</div>
	for _, id := range res.Done {
		<div id={ "proposal-" + i64(id) } hx-swap-oob="delete"></div>
	}
	for _, f := range res.Failed {
		<p id={ "proposal-err-" + i64(f.ID) } class={ rowErrorCls } role="alert" hx-swap-oob="true">{ f.Reason }</p>
	}
}
