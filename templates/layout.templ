package templates

type Nav string

const (
	NavDashboard Nav = "dashboard"
	NavChanges   Nav = "changes"
	NavPosts     Nav = "posts"
	NavReviews   Nav = "reviews"
	NavCafes     Nav = "cafes"
	NavLocations Nav = "locations"
	NavTags      Nav = "tags"
	NavRatings   Nav = "ratings"
	NavSources   Nav = "sources"
	NavUsers     Nav = "users"
)

type navItem struct {
	key   Nav
	label string
	href  string
}

var navItems = []navItem{
	{NavChanges, "Changes", "/changes"},
	{NavPosts, "Posts", "/posts"},
	{NavReviews, "Reviews", "/reviews"},
	{NavSources, "Sources", "/sources"},
	{NavCafes, "Cafes", "/cafes"},
	{NavLocations, "Locations", "/locations"},
	{NavTags, "Tags", "/tags"},
	{NavRatings, "Ratings", "/rating-categories"},
	{NavUsers, "Users", "/users"},
}

// Layout is the document shell. The header copies the public site's Header
// (bandung-coffeeshop-fe src/components/Header.tsx), with the admin sections as
// its links.
templ Layout(title string, active Nav) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="robots" content="noindex, nofollow"/>
			<title>{ title } · Mission Control · BDGCafé</title>
			<link rel="preload" href="/static/vendor/fonts/plus-jakarta-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin/>
			<link rel="stylesheet" href="/static/css/app.css"/>
			<script src="/static/vendor/htmx.min.js" defer></script>
			<script src="/static/js/forms.js" defer></script>
		</head>
		<body class="m-0 flex min-h-screen flex-col bg-cream">
			<header class="sticky top-0 z-[1100] flex h-12 items-center justify-between gap-6 border-b border-grove-light bg-cream px-6 md:px-16">
				<a href="/" class="flex shrink-0 items-baseline gap-2 no-underline">
					<span class="text-xl font-bold text-[#2A3D22]">BDGCafé</span>
					<span class="hidden text-xs font-semibold text-bark sm:inline">Mission control</span>
				</a>
				<nav aria-label="Primary" class="flex items-center gap-4 overflow-x-auto whitespace-nowrap font-medium md:gap-8">
					for _, it := range navItems {
						<a
							href={ templ.URL(it.href) }
							class={ "text-sm no-underline", templ.KV("font-bold text-forest", it.key == active), templ.KV("text-moss", it.key != active) }
							if it.key == active {
								aria-current="page"
							}
						>{ it.label }</a>
					}
				</nav>
			</header>
			{ children... }
		</body>
	</html>
}

// Page is the console's page wrapper: <main> + centered column.
templ Page(width string) {
	<main class={ mainCls }>
		<div class={ width }>
			{ children... }
		</div>
	</main>
}

templ BackLink(href, label string) {
	<a href={ templ.URL(href) } class={ backLinkCls }>
		@Icon("arrow-left", 16)
		{ label }
	</a>
}

// Notice renders a flash message passed through the ?ok= / ?err= query.
templ Notice(ok, errMsg string) {
	if ok != "" {
		<div class={ okBoxCls } role="status">{ ok }</div>
	}
	if errMsg != "" {
		@ErrorBox(errMsg)
	}
}

templ ErrorBox(msg string) {
	<div class={ errorBoxCls } role="alert">{ msg }</div>
}

// StatusBadge is the console's status pill.
templ StatusBadge(status string) {
	<span class={ pillCls, statusColor(status) }>{ status }</span>
}

templ SourceBadge(source string) {
	<span class={ "w-fit", pillCls, sourceColor(source) }>{ sourceLabel(source) }</span>
}

templ Field(label string) {
	<label class="flex flex-col gap-1">
		<span class={ labelCls }>{ label }</span>
		{ children... }
	</label>
}

// NotFound mirrors the console routes' errorComponent.
templ NotFound(what string) {
	@Layout("Not found", "") {
		<main class="flex flex-1 flex-col items-center justify-center gap-4 py-32 text-forest">
			<p class="text-xl font-semibold">Failed to load { lower(what) }.</p>
			<a href={ templ.URL(notFoundBack(what)) } class="rounded-lg bg-forest px-6 py-3 text-sm text-cream">{ notFoundBackLabel(what) }</a>
		</main>
	}
}

func notFoundBack(what string) string {
	switch what {
	case "Cafe", "Feed entry":
		return "/cafes"
	case "Location":
		return "/locations"
	case "Post":
		return "/posts"
	case "Snapshot":
		return "/sources"
	case "User":
		return "/users"
	case "Review":
		return "/reviews"
	default:
		return "/"
	}
}

func notFoundBackLabel(what string) string {
	switch what {
	case "Cafe", "Feed entry":
		return "Back to cafes"
	case "Location":
		return "Back to locations"
	case "Post":
		return "Back to posts"
	case "Snapshot":
		return "Back to sources"
	case "User":
		return "Back to users"
	case "Review":
		return "Back to reviews"
	default:
		return "Admin home"
	}
}
